
EXPO_PUBLIC_API_URL=https://automax.example.com/api/v1

# App identity — change these per client/release
APP_NAME=name

APP_ENV=production
EXPO_PUBLIC_APP_VERSION=1.0.5
EXPO_PUBLIC_APP_VERSION_CODE=1

# Set to true to disable biometric authentication when user session is cached
EXPO_PUBLIC_DISABLE_BIOMETRICS=false

#set true to disable auto location retrieval
EXPO_PUBLIC_DISABLE_AUTO_LOCATION_RETRIEVAL=false
EXPO_PUBLIC_ENABLE_GIS=true

# Set to true to show both Employee and Citizen login tabs; false shows only Employee login
EXPO_PUBLIC_ENABLE_CITIZEN_LOGIN=true

# Variables to unlock viewer app capability
EXPO_PUBLIC_VIEWER_APP=true
EXPO_PUBLIC_VIEWER_APP_ROLES=viewer,viewer2

# Maximum number of attachments a reporter can add to a single incident. Default: 10
EXPO_PUBLIC_MAX_INCIDENT_ATTACHMENTS=1

# Maximum characters allowed in the incident description field. Leave unset
# (commented out) for no limit — there is no default.
EXPO_PUBLIC_MAX_DESCRIPTION_LENGTH=300

# Set to true to require every image attachment to pass server-side validation
# (POST /images/validate) before an incident can be created. Default: false (off)
EXPO_PUBLIC_IMAGE_VALIDATION_REQUIRED=false

# Android/iOS identifiers (optional override)
ANDROID_PACKAGE=com.automax.mobile
IOS_BUNDLE_ID=com.automax.mobile

# App icon background color for Android adaptive icon
APP_ICON_BG_COLOR=#ffffff

 